# Everything here is optional. With nothing set, the client, the tests and
# the demo run fully offline against the in memory backend.

# Supabase project (apply the files in sql/ first)
SUPABASE_URL=
# anon key for user sessions, or service key for trusted server code
SUPABASE_KEY=
# a signed in user's JWT, so row level security can match auth.uid()
SUPABASE_ACCESS_TOKEN=

# Agent namespace inside one owner
AGENT_ID=default

# Embeddings. Leave the key empty to use the offline hash embedder.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small

# Only for the integration tests: a Postgres with pgvector
DATABASE_URL=
